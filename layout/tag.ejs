<div class="tag-container">
    <h1 class="tag-title">标签: <%= page.tag %></h1>
    
    <ul class="tag-post-list">
    <% page.posts.sort('date', -1).forEach(function(post){ %>
        <li class="tag-post-item">
            <span class="tag-post-date"><%= date(post.date, 'YYYY-MM-DD') %></span>
            <a href="<%= url_for(post.path) %>" class="tag-post-title"><%= post.title || '(无标题)' %></a>
        </li>
    <% }) %>
    </ul>
</div>

<% if (page.total > 1) { %>
<div class="pagination tag-pagination">
    <% if (page.prev) { %>
    <a href="<%= url_for(page.prev_link) %>" class="prev-page">上一页</a>
    <% } %>
    
    <% if (page.next) { %>
    <a href="<%= url_for(page.next_link) %>" class="next-page">下一页</a>
    <% } %>
</div>
<% } %> 