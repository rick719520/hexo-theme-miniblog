<div class="archive-container">
    <h1 class="archive-title">文章归档</h1>
    
    <% let lastYear; %>
    <% page.posts.sort('date', -1).forEach(function(post){ %>
        <% let currentYear = date(post.date, 'YYYY'); %>
        
        <% if (lastYear !== currentYear) { %>
            <% if (lastYear) { %>
                </ul>
            <% } %>
            <h2 class="archive-year"><%= currentYear %></h2>
            <ul class="archive-list">
            <% lastYear = currentYear; %>
        <% } %>
        
        <li class="archive-item">
            <span class="archive-date"><%= date(post.date, 'MM-DD') %></span>
            <a href="<%= url_for(post.path) %>" class="archive-title"><%= post.title || '(无标题)' %></a>
        </li>
    <% }) %>
    
    <% if (lastYear) { %>
        </ul>
    <% } %>
</div>

<% if (page.total > 1) { %>
<div class="pagination archive-pagination">
    <% if (page.prev) { %>
    <a href="<%= url_for(page.prev_link) %>" class="prev-page">上一页</a>
    <% } %>
    
    <% if (page.next) { %>
    <a href="<%= url_for(page.next_link) %>" class="next-page">下一页</a>
    <% } %>
</div>
<% } %> 