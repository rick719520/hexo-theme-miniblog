<% site.posts.sort('date', -1).limit(config.index_generator.per_page || 10).each(function(post){ %>
<article class="post">
    <h2><a href="<%= url_for(post.path) %>"><%= post.title %></a></h2>
    <div class="post-meta">发布于 <%= date(post.date, "YYYY-MM-DD") %></div>
    <p><%= post.excerpt || post.description || truncate(strip_html(post.content), {length: 150}) %></p>
</article>
<% }) %>

<% if (page.total > 1) { %>
<div class="pagination">
    <% if (page.prev) { %>
    <a href="<%= url_for(page.prev_link) %>" class="prev-page">上一页</a>
    <% } %>
    
    <% if (page.next) { %>
    <a href="<%= url_for(page.next_link) %>" class="next-page">下一页</a>
    <% } %>
</div>
<% } %> 